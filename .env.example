# Environment variables — copy to .env and fill in your values

# ── Google Earth Engine ──────────────────────────────────────────────────────
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=infra/gee-service-account-key.json
GEE_PROJECT=your-gcp-project-id

# ── Gemini / Vertex AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Or for Vertex AI:
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1

# ── Database (PostGIS / Supabase) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cyclone_platform
# For Supabase:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15005550006   # Twilio sandbox number

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── Weather APIs ─────────────────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
JTWC_FTP_BASE=https://www.metoc.navy.mil/jtwc/products

# ── Auth (Supabase Auth or Auth0) ────────────────────────────────────────────
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App settings ─────────────────────────────────────────────────────────────
APP_ENV=development     # development | production
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Mock insurer webhook (for demo) ──────────────────────────────────────────
MOCK_INSURER_WEBHOOK_URL=http://localhost:9000/mock-insurer/trigger
